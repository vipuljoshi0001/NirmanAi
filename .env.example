# Nirman-AI (Paimana) — LLM narrative configuration
# Copy to `.env` in the project root and fill in your key.
# The backend (llm.py) loads this automatically when it starts.

# OpenRouter API key (https://openrouter.ai/keys)
# Without it, the AI brief falls back to the deterministic template text.
OPENROUTER_API_KEY=""

# Optional: override the default model (qwen/qwen3-reranker-8b)
#OPENROUTER_MODEL="qwen/qwen3-reranker-8b"

# Optional: override the API base (default https://openrouter.ai/api/v1)
#OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Deployment URL of the app (used by integrations/reporting)
APP_URL="http://localhost:8000"